@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap');
@tailwind base;
@tailwind components;
@tailwind utilities;



:root {
  color: rgba(255, 255, 255, 0.87);
  background-color: #242424;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
}

.container {
  width: 90%;
  margin: 0 auto;
  padding-top: 50px;
  padding-bottom: 50px;
}

/* Hero Background */
.hero-bg {
  background-image: url('./assets/Pattern.png');
  background-size: cover;
  background-position: center;
  height: 100%;
  position: relative;
}

/* Dark Overlay using ::before */
.hero-bg::before {
  content: '';
  position: absolute;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.1);
  z-index: 0;
}

/* Ensure content is above the overlay */
.hero-bg > * {
  position: relative;
  z-index: 1;
}

img {
  max-width: 100% !important;
}

/* Apply Poppins font globally */
body {
  font-family: 'Poppins', sans-serif;
  margin: 0 !important;
}

/* Preloader styles */
svg path {
  stroke: #ffffff;
  stroke-width: 2;
  fill: none;
}

.orange-stroke path {
  stroke: #F75F0B;
  stroke-width: 2;
  fill: none;
  stroke-dasharray: 1000;
  stroke-dashoffset: 1000;
  animation: drawStroke 3s ease-in-out infinite;
}

@keyframes drawStroke {
  to {
    stroke-dashoffset: 0;
  }
}

/* Brand color utilities */
.bg-teal-900 {
  background-color: #023942;
}

.text-teal-900 {
  color: #2FA0B5;
}

.text-orange-500 {
  color: #F75F0B;
}

.bg-orange-500 {
  background-color: #F75F0B;
}

.bg-orange-600 {
  background-color: #E0540A;
}

.border-orange-500 {
  border-color: #F75F0B;
}

.text-light-cyan {
  color: #CFF8FF;
}

.font-poppins {
  font-family: 'Poppins', sans-serif;
}

.benefit-card p {
  font-size: 14px;
  color: #cccccc;
  line-height: 1.5;
}

/* ========== GRID SYSTEMS FOR NEW PAGES ========== */
.project-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  margin-top: 48px;
}

@media (min-width: 768px) {
  .project-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .project-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.project-card {
  background-color: #131313;
  border-radius: 16px;
  padding: 32px;
  border: 1px solid #333333;
}

.team-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  margin-top: 48px;
}

@media (min-width: 768px) {
  .team-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .team-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  margin-top: 32px;
}

@media (min-width: 768px) {
  .stats-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* ========== HERO SECTION FOR NEW PAGES ========== */
.hero-section:not(.landing-hero) {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-section:not(.landing-hero) .container {
  position: relative;
  z-index: 10;
}

.hero-section:not(.landing-hero) .hero-txt {
  margin-top: 0;
  margin-bottom: 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 20px;
  position: relative;
  z-index: 10;
}

.hero-section:not(.landing-hero) .herotwo-heading {
  margin-bottom: 24px;
  position: relative;
  z-index: 10;
}

.hero-section:not(.landing-hero) .h__txt {
  max-width: 600px;
  margin: 0 auto;
  text-align: center;
  position: relative;
  z-index: 10;
}

.hero-section:not(.landing-hero) .sm__txt {
  position: relative;
  z-index: 10;
}

@media screen and (max-width: 768px) {
  h1 {
    font-size: 45px !important;
  }
  h2 {
    font-size: 36px !important;
    font-weight: 400;
    margin: 0 auto;
  }
  p {
    font-size: 14px !important;
  }
}