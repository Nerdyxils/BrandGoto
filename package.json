{
  "name": "brandgoto-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-routes.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:lead-delivery": "node scripts/lead-function-test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test:lead-delivery && npm run build && npm run smoke"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
